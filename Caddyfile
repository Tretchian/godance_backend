# Глобальные настройки ACME.
{
	email {$ACME_EMAIL}
	# Только Let's Encrypt: ZeroSSL (запасной CA у Caddy) отклоняет бесплатные
	# и динамические домены (*.sslip.io, *.duckdns.org, технические домены
	# хостингов) — для них подходит именно Let's Encrypt.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# API: https://api.<домен> → Gin на app:8080
{$API_DOMAIN} {
	encode gzip
	reverse_proxy app:8080
}

# Публичный MinIO для presigned-ссылок (видео).
# Раскомментируйте и задайте STORAGE_DOMAIN, если раздаёте видео.
# Тогда в .env: MINIO_PUBLIC_ENDPOINT=https://<storage-домен>
