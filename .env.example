# ── Database ────────────────────────────────────────────────────────────────
# В docker-compose DB_HOST/DB_PORT переопределяются на postgres:5432.
# Значения ниже — для локального запуска (go run) против контейнера Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=godance
DB_PASSWORD=godance
DB_NAME=godance
DB_SSLMODE=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Object storage (MinIO / S3) ──────────────────────────────────────────────
# MINIO_ENDPOINT       — внутренний адрес для серверных операций (HEAD, бакет).
#                        В docker-compose переопределяется на http://minio:9000.
# MINIO_PUBLIC_ENDPOINT — адрес, по которому presigned-ссылки откроет клиент
#                        (браузер/мобайл). Подпись валидна только для него.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=godance-videos
MINIO_REGION=us-east-1

# ── Domain config ─────────────────────────────────────────────────────────────
FEEDBACK_PRICE=500
PAYMENT_GATEWAY_URL=https://pay.example.com

# ── Worker ────────────────────────────────────────────────────────────────────
# Интервал опроса просроченных запросов ОС (Go-duration: 30s, 1m, 5m ...).
WORKER_INTERVAL=1d
