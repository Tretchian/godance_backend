# ── Database ────────────────────────────────────────────────────────────────
# В docker-compose DB_HOST/DB_PORT переопределяются на postgres:5432.
# Значения ниже — для локального запуска (go run) против контейнера Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=godance
DB_PASSWORD=godance
DB_NAME=godance
DB_SSLMODE=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Object storage (MinIO / S3) ──────────────────────────────────────────────
# MINIO_ENDPOINT       — внутренний адрес для серверных операций (HEAD, бакет).
#                        В docker-compose переопределяется на http://minio:9000.
# MINIO_PUBLIC_ENDPOINT — адрес, по которому presigned-ссылки откроет клиент
#                        (браузер/мобайл). Подпись валидна только для него.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=godance-videos
MINIO_REGION=us-east-1

# ── Domain config ─────────────────────────────────────────────────────────────
FEEDBACK_PRICE=500
PAYMENT_GATEWAY_URL=https://pay.example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Разрешённые origin-ы фронта через запятую. Если пусто — берётся дефолт
# (http://localhost:3000 + прод-домен Vercel). Превью *.vercel.app разрешены всегда.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dancefeedbackplatform.vercel.app

# ── Worker ────────────────────────────────────────────────────────────────────
# Интервал опроса просроченных запросов ОС (Go-duration: 30s, 1m, 5m ...).
WORKER_INTERVAL=1m

# ── Production (docker-compose.prod.yml + Caddy) ──────────────────────────────
# Домен API (A-запись на IP VPS). Caddy сам выпустит TLS-сертификат.
API_DOMAIN=api.example.com
# Email для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=admin@example.com
# Опционально: отдельный поддомен для публичного MinIO (раздача видео).
# Если задан — раскомментируйте блок в Caddyfile и выставьте:
#   MINIO_PUBLIC_ENDPOINT=https://storage.example.com
STORAGE_DOMAIN=
#
# В проде обязательно переопределите:
#   JWT_SECRET             — длинная случайная строка
#   MINIO_PUBLIC_ENDPOINT  — публичный HTTPS-адрес MinIO (или оставьте stub: уберите MINIO_ENDPOINT)
#   CORS_ALLOWED_ORIGINS   — прод-домен фронта на Vercel
